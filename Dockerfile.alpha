FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_APP_VERSION
ARG RAILWAY_GIT_COMMIT_SHA
ENV VITE_AUTH_PROVIDER=better-auth
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile.alpha /etc/caddy/Caddyfile
