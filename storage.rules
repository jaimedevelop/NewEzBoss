rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Estimate attachments migrated to private R2/API delivery. Firebase
    // auth alone must never authorize an arbitrary estimate path.
    match /estimates/{estimateId}/{allPaths=**} {
      allow read, write: if false;
    }
    
    // Allow authenticated users to read and write to their own user folder
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
