rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Only these legacy owner workspaces still use direct Firestore access.
    // A generic recursive allow would override denials for migrated API data.
    function legacyCollection(name) {
      return name in ['bankAccounts', 'financeCategories', 'budgetGoals',
        'payments', 'calendarEvents', 'bank_transactions', 'transaction_categories'];
    }
    match /{collection}/{document} {
      allow read, delete: if legacyCollection(collection) && signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if legacyCollection(collection) && signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if legacyCollection(collection) && signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }
    // All API-migrated collections, unknown collections and nested paths deny.
    match /{document=**} { allow read, write: if false; }
  }
}
