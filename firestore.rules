rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Estimate access migrated to the API. Leaving token lookups readable
    // makes a guessed document id equivalent to a bearer credential.
    match /estimateTokens/{token} {
      allow read, write: if false;
    }

    // Estimates migrated to PostgreSQL/API. Do not re-open this collection
    // for the Auth0-to-Firebase bridge; its Firebase UID is not proof of API
    // ownership and a non-null token is never authorization by itself.
    match /estimates/{estimateId} {
      allow read, write: if false;
    }

    // Default rule: deny all access
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
