{
  "manifest_version": 3,
  "name": "EzBoss Product Importer",
  "version": "3.1",
  "description": "Import products directly from Home Depot, Lowe's, Ferguson, and Hydrologic into EzBoss",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.homedepot.com/*",
    "https://*.lowes.com/*",
    "https://*.ferguson.com/*",
    "https://*.winsupplyinc.com/*",
    "https://*.hydrologicsupply.com/*",
    "https://ezboss.pro/*",
    "https://www.ezboss.pro/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.homedepot.com/*",
        "https://*.lowes.com/*",
        "https://*.ferguson.com/*",
        "https://*.winsupplyinc.com/*",
        "https://*.hydrologicsupply.com/*",
        "https://ezboss.pro/*",
        "https://www.ezboss.pro/*",
        "http://localhost:5173/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
